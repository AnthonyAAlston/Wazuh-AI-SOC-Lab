digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.4", nodesep="0.55", ranksep="0.75"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=12, margin="0.18,0.12"];
  edge [fontname="Arial", fontsize=10];

  win [label="Windows 11 Endpoint\nWazuh Agent"];
