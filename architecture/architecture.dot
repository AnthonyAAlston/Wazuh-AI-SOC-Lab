  fim [label="File Integrity Monitoring\nRules 550 / 554"];
  py [label="Python AI Forwarder\nFlask + Waitress + systemd"];
  openai [label="OpenAI API\nStructured SOC Analysis"];
  api [label="Authenticated Local API\n/health  /api/latest  /api/analyses"];
  lan [label="Lab Network\n192.168.1.0/24"];
